package com.sparkyapps.sparkyfitness.widget

import android.app.AlarmManager
import android.app.PendingIntent
import android.appwidget.AppWidgetManager
import android.content.ComponentName
import android.content.Context
import android.content.Intent
import android.util.Log
import androidx.glance.appwidget.GlanceAppWidget
import androidx.glance.appwidget.GlanceAppWidgetReceiver
import androidx.glance.appwidget.GlanceAppWidgetManager
import androidx.glance.appwidget.state.updateAppWidgetState
import androidx.glance.appwidget.updateAll
import java.io.OutputStreamWriter
import java.net.HttpURLConnection
import java.net.URL
import java.time.LocalDate
import java.time.ZoneId
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import org.json.JSONObject

open class HydrationWidgetReceiver : GlanceAppWidgetReceiver() {

    override val glanceAppWidget: GlanceAppWidget = HydrationWidget()

    override fun onReceive(context: Context, intent: Intent) {
        when (intent.action) {
            ACTION_MIDNIGHT_REFRESH -> {
                val pending = goAsync()
                CoroutineScope(Dispatchers.Default).launch {
                    try {
                        glanceAppWidget.updateAll(context)
                        scheduleMidnightRefresh(context)
                    } finally {
                        pending.finish()
                    }
                }
                return
            }
            ACTION_ADJUST_WATER -> {
                val pending = goAsync()
                val amountMl = intent.getIntExtra(EXTRA_AMOUNT_ML, 0)
                Log.i(TAG, "Received water adjustment action amountMl=$amountMl")
                CoroutineScope(Dispatchers.IO).launch {
                    try {
                        adjustWater(context, amountMl)
                        scheduleMidnightRefresh(context)
                    } finally {
                        pending.finish()
                    }
                }
                return
            }
        }
        super.onReceive(context, intent)
    }

    override fun onUpdate(
        context: Context,
        appWidgetManager: AppWidgetManager,
        appWidgetIds: IntArray,
    ) {
        super.onUpdate(context, appWidgetManager, appWidgetIds)
        scheduleMidnightRefresh(context)
    }

    override fun onDisabled(context: Context) {
        super.onDisabled(context)
        cancelMidnightRefresh(context)
    }

    companion object {
        const val PREFS_NAME = "SparkyHydrationWidget"
        const val PREFS_KEY_SNAPSHOT = "hydrationSnapshot"
        private const val TAG = "HydrationWidget"
        const val ACTION_MIDNIGHT_REFRESH =
            "com.sparkyapps.sparkyfitness.widget.ACTION_HYDRATION_MIDNIGHT_REFRESH"
        const val ACTION_ADJUST_WATER =
            "com.sparkyapps.sparkyfitness.widget.ACTION_ADJUST_WATER"
        const val EXTRA_AMOUNT_ML = "amountMl"
        private const val MIDNIGHT_BUFFER_MS = 1_000L
        private const val MIDNIGHT_REQUEST_CODE = 3

        fun scheduleMidnightRefresh(context: Context) {
            if (allWidgetIds(context).isEmpty()) return

            val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as? AlarmManager
                ?: return
            alarmManager.setAndAllowWhileIdle(
                AlarmManager.RTC,
                nextMidnightMillis(),
                midnightPendingIntent(context),
            )
        }

        fun cancelMidnightRefresh(context: Context) {
            val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as? AlarmManager
                ?: return
            alarmManager.cancel(midnightPendingIntent(context))
        }

        fun allWidgetIds(context: Context): IntArray {
            val manager = AppWidgetManager.getInstance(context)
            return listOf(
                HydrationWidgetReceiver::class.java,
                HydrationWidgetQuickAddReceiver::class.java,
                HydrationWidgetMediumReceiver::class.java,
                HydrationWidgetLargeReceiver::class.java,
            ).flatMap { receiverClass ->
                manager.getAppWidgetIds(ComponentName(context, receiverClass)).asIterable()
            }.toIntArray()
        }

        private suspend fun refreshWidgetState(context: Context, json: String) {
            val manager = GlanceAppWidgetManager(context)
            manager.getGlanceIds(HydrationWidget::class.java).forEach { id ->
                updateAppWidgetState(context, id) { state ->
                    state[HydrationWidget.SNAPSHOT_STATE_KEY] = json
                }
                HydrationWidget().update(context, id)
            }
        }

        private suspend fun adjustWater(context: Context, amountMl: Int) {
            if (amountMl == 0) return
            val prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
            val rawSnapshot = prefs.getString(PREFS_KEY_SNAPSHOT, null) ?: return
            val snapshot = JSONObject(rawSnapshot)
            val actionConfig = snapshot.optJSONObject("actionConfig") ?: run {
                Log.w(TAG, "Water adjustment skipped: missing actionConfig")
                markStatus(context, snapshot, "needsSetup")
                return
            }
            val date = snapshot.optString("date", "")
            val baseUrl = actionConfig.optString("baseUrl", "").trimEnd('/')
            val authHeader = actionConfig.optString("authHeader", "")
            if (date.isBlank() || baseUrl.isBlank() || authHeader.isBlank()) {
                Log.w(
                    TAG,
                    "Water adjustment skipped: missing required config dateBlank=${date.isBlank()} baseUrlBlank=${baseUrl.isBlank()} authBlank=${authHeader.isBlank()}",
                )
                markStatus(context, snapshot, "needsSetup")
                return
            }

            try {
                Log.i(TAG, "Preparing water adjustment amountMl=$amountMl date=$date base=${safeBaseUrl(baseUrl)}")
                val response = postWaterAdjustment(baseUrl, authHeader, actionConfig, date, amountMl)
                val newConsumedMl = response.optDouble(
                    "water_ml",
                    (snapshot.optDouble("consumedMl", 0.0) + amountMl).coerceAtLeast(0.0),
                )
                val goalMl = snapshot.optDouble("goalMl", 0.0).coerceAtLeast(0.0)
                snapshot.put("consumedMl", newConsumedMl.coerceAtLeast(0.0))
                snapshot.put("progress", if (goalMl > 0.0) (newConsumedMl / goalMl).coerceIn(0.0, 1.0) else 0.0)
                snapshot.put("consumedText", formatWater(newConsumedMl))
                snapshot.put("lastUpdated", System.currentTimeMillis() / 1000L)
                snapshot.put("status", "ok")
                val updated = snapshot.toString()
                prefs.edit().putString(PREFS_KEY_SNAPSHOT, updated).commit()
                refreshWidgetState(context, updated)
                Log.i(TAG, "Water adjustment succeeded amountMl=$amountMl consumedMl=$newConsumedMl")
            } catch (e: Exception) {
                Log.e(TAG, "Water adjustment failed amountMl=$amountMl: ${e.message}", e)
                markStatus(context, snapshot, "failed")
            }
        }

        private fun postWaterAdjustment(
            baseUrl: String,
            authHeader: String,
            actionConfig: JSONObject,
            date: String,
            amountMl: Int,
        ): JSONObject {
            val primary = postWaterAdjustmentOnce(
                URL("$baseUrl/api/measurements/water-intake/amount"),
                authHeader,
                actionConfig,
                date,
                amountMl,
            )
            val response = if (primary.status == 404) {
                Log.w(
                    TAG,
                    "Primary water endpoint returned 404, retrying v2 endpoint primary=${primary.endpoint}",
                )
                postWaterAdjustmentOnce(
                    URL("$baseUrl/api/v2/measurements/water-intake/amount"),
                    authHeader,
                    actionConfig,
                    date,
                    amountMl,
                )
            } else {
                primary
            }

            if (response.status !in 200..299) {
                throw IllegalStateException("Water adjustment failed: ${response.status} ${response.body}")
            }
            return if (response.body.isBlank()) JSONObject() else JSONObject(response.body)
        }

        private fun postWaterAdjustmentOnce(
            url: URL,
            authHeader: String,
            actionConfig: JSONObject,
            date: String,
            amountMl: Int,
        ): WaterAdjustmentHttpResponse {
            val endpoint = url.toExternalForm()
            Log.i(TAG, "Posting water adjustment endpoint=$endpoint")
            val connection = (url.openConnection() as HttpURLConnection).apply {
                requestMethod = "POST"
                connectTimeout = 10_000
                readTimeout = 10_000
                doOutput = true
                setRequestProperty("Authorization", authHeader)
                setRequestProperty("Content-Type", "application/json")
                setRequestProperty("X-Meal-Model-Version", "2")
            }

            val proxyHeaders = actionConfig.optJSONObject("proxyHeaders")
            proxyHeaders?.keys()?.forEach { key ->
                connection.setRequestProperty(key, proxyHeaders.optString(key))
            }

            OutputStreamWriter(connection.outputStream, Charsets.UTF_8).use { writer ->
                writer.write(
                    JSONObject()
                        .put("entry_date", date)
                        .put("water_ml", amountMl)
                        .toString(),
                )
            }

            val status = connection.responseCode
            val body = if (status in 200..299) {
                connection.inputStream.bufferedReader().use { it.readText() }
            } else {
                connection.errorStream?.bufferedReader()?.use { it.readText() }.orEmpty()
            }
            connection.disconnect()
            Log.i(TAG, "Water adjustment response endpoint=$endpoint status=$status bodyLength=${body.length}")

            return WaterAdjustmentHttpResponse(
                status = status,
                body = body,
                endpoint = endpoint,
            )
        }

        private fun safeBaseUrl(baseUrl: String): String {
            return try {
                val parsed = URL(baseUrl)
                val portSuffix = if (parsed.port == -1) "" else ":${parsed.port}"
                "${parsed.protocol}://${parsed.host}$portSuffix"
            } catch (e: Exception) {
                "<invalid>"
            }
        }

        private data class WaterAdjustmentHttpResponse(
            val status: Int,
            val body: String,
            val endpoint: String,
        )

        private suspend fun markStatus(context: Context, snapshot: JSONObject, status: String) {
            snapshot.put("status", status)
            val updated = snapshot.toString()
            context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
                .edit()
                .putString(PREFS_KEY_SNAPSHOT, updated)
                .commit()
            refreshWidgetState(context, updated)
        }

        private fun formatWater(ml: Double): String {
            if (ml >= 1000.0) {
                val liters = ml / 1000.0
                return if (liters % 1.0 == 0.0) {
                    "${liters.toInt()} L"
                } else {
                    String.format(java.util.Locale.getDefault(), "%.1f L", liters)
                }
            }
            return "${ml.toInt()} ml"
        }

        private fun midnightPendingIntent(context: Context): PendingIntent {
            val intent = Intent(context, HydrationWidgetReceiver::class.java).apply {
                action = ACTION_MIDNIGHT_REFRESH
            }
            val flags = PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
            return PendingIntent.getBroadcast(context, MIDNIGHT_REQUEST_CODE, intent, flags)
        }

        private fun nextMidnightMillis(): Long {
            val zone = ZoneId.systemDefault()
            val tomorrowMidnight = LocalDate.now(zone)
                .plusDays(1)
                .atStartOfDay(zone)
                .toInstant()
                .toEpochMilli()
            return tomorrowMidnight + MIDNIGHT_BUFFER_MS
        }
    }
}

class HydrationWidgetQuickAddReceiver : HydrationWidgetReceiver()

class HydrationWidgetMediumReceiver : HydrationWidgetReceiver()

class HydrationWidgetLargeReceiver : HydrationWidgetReceiver()
