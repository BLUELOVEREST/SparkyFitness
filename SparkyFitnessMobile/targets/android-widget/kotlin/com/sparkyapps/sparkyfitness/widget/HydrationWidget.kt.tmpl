package com.sparkyapps.sparkyfitness.widget

import android.content.Context
import android.content.Intent
import android.net.Uri
import androidx.compose.runtime.Composable
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.unit.DpSize
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import androidx.datastore.preferences.core.Preferences
import androidx.datastore.preferences.core.stringPreferencesKey
import androidx.glance.GlanceId
import androidx.glance.GlanceModifier
import androidx.glance.GlanceTheme
import androidx.glance.LocalSize
import androidx.glance.action.clickable
import androidx.glance.appwidget.GlanceAppWidget
import androidx.glance.appwidget.LinearProgressIndicator
import androidx.glance.appwidget.SizeMode
import androidx.glance.appwidget.action.actionSendBroadcast
import androidx.glance.appwidget.action.actionStartActivity
import androidx.glance.appwidget.provideContent
import androidx.glance.background
import androidx.glance.currentState
import androidx.glance.layout.Alignment
import androidx.glance.layout.Box
import androidx.glance.layout.Column
import androidx.glance.layout.Row
import androidx.glance.layout.Spacer
import androidx.glance.layout.fillMaxSize
import androidx.glance.layout.fillMaxWidth
import androidx.glance.layout.height
import androidx.glance.layout.padding
import androidx.glance.layout.width
import androidx.glance.state.PreferencesGlanceStateDefinition
import androidx.glance.text.FontWeight
import androidx.glance.text.Text
import androidx.glance.text.TextStyle
import androidx.glance.unit.ColorProvider
import java.time.Instant
import java.time.LocalDate
import java.time.ZoneId
import java.time.format.DateTimeFormatter
import java.util.Locale
import org.json.JSONObject

class HydrationWidget : GlanceAppWidget() {

    override val stateDefinition = PreferencesGlanceStateDefinition

    override val sizeMode: SizeMode = SizeMode.Responsive(
        setOf(
            DpSize(70.dp, 70.dp),
            DpSize(150.dp, 90.dp),
            DpSize(240.dp, 150.dp),
            DpSize(320.dp, 170.dp),
        ),
    )

    override suspend fun provideGlance(context: Context, id: GlanceId) {
        val fallbackSnapshot = loadSnapshot(context)
        provideContent {
            GlanceTheme {
                WidgetContent(context = context, fallbackSnapshot = fallbackSnapshot)
            }
        }
    }

    @Composable
    private fun WidgetContent(context: Context, fallbackSnapshot: HydrationSnapshot?) {
        val state = currentState<Preferences>()
        val snapshot = parseSnapshot(state[SNAPSHOT_STATE_KEY]) ?: fallbackSnapshot
        val size = LocalSize.current
        val openAppIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://"))
            .setPackage(context.packageName)

        if (size.width < 120.dp && size.height < 120.dp) {
            QuickAddLayout(context)
            return
        }

        Box(
            modifier = GlanceModifier
                .fillMaxSize()
                .background(GlanceTheme.colors.surface)
                .appWidgetBackgroundCornerRadius()
                .padding(12.dp)
                .clickable(actionStartActivity(openAppIntent)),
        ) {
            when {
                size.width < 200.dp -> SmallLayout(context, snapshot)
                size.width < 300.dp -> MediumLayout(context, snapshot)
                else -> LargeLayout(context, snapshot)
            }
        }
    }

    @Composable
    private fun QuickAddLayout(context: Context) {
        val intent = Intent(context, HydrationWidgetReceiver::class.java).apply {
            action = HydrationWidgetReceiver.ACTION_ADJUST_WATER
            putExtra(HydrationWidgetReceiver.EXTRA_AMOUNT_ML, 250)
        }

        Box(
            modifier = GlanceModifier
                .fillMaxSize()
                .background(HydrationBlue)
                .appWidgetBackgroundCornerRadius()
                .clickable(actionSendBroadcast(intent)),
            contentAlignment = Alignment.Center,
        ) {
            Text(
                text = "+250",
                style = TextStyle(
                    color = ColorProvider(Color.White),
                    fontSize = 18.sp,
                    fontWeight = FontWeight.Bold,
                ),
                maxLines = 1,
            )
        }
    }

    @Composable
    private fun SmallLayout(context: Context, snapshot: HydrationSnapshot?) {
        Column(modifier = GlanceModifier.fillMaxSize()) {
            Header(snapshot = snapshot, titleSize = 17)
            Spacer(modifier = GlanceModifier.height(6.dp))
            Progress(snapshot = snapshot)
            StatusLabel(snapshot = snapshot, compact = true)
            Spacer(modifier = GlanceModifier.defaultWeight())
            Row(modifier = GlanceModifier.fillMaxWidth()) {
                AmountButton(context, "-250", -250, GlanceModifier.defaultWeight())
                Spacer(modifier = GlanceModifier.width(8.dp))
                AmountButton(context, "+250", 250, GlanceModifier.defaultWeight())
            }
        }
    }

    @Composable
    private fun MediumLayout(context: Context, snapshot: HydrationSnapshot?) {
        Column(modifier = GlanceModifier.fillMaxSize()) {
            Header(snapshot = snapshot, titleSize = 20)
            Spacer(modifier = GlanceModifier.height(8.dp))
            Progress(snapshot = snapshot)
            StatusLabel(snapshot = snapshot, compact = true)
            Spacer(modifier = GlanceModifier.defaultWeight())
            Row(modifier = GlanceModifier.fillMaxWidth()) {
                AmountButton(context, "+250", 250, GlanceModifier.defaultWeight())
                Spacer(modifier = GlanceModifier.width(6.dp))
                AmountButton(context, "+350", 350, GlanceModifier.defaultWeight())
                Spacer(modifier = GlanceModifier.width(6.dp))
                AmountButton(context, "+500", 500, GlanceModifier.defaultWeight())
                Spacer(modifier = GlanceModifier.width(6.dp))
                AmountButton(context, "-250", -250, GlanceModifier.defaultWeight())
            }
        }
    }

    @Composable
    private fun LargeLayout(context: Context, snapshot: HydrationSnapshot?) {
        Column(modifier = GlanceModifier.fillMaxSize()) {
            Text(
                text = "Hydration",
                style = TextStyle(
                    color = GlanceTheme.colors.onSurfaceVariant,
                    fontSize = 14.sp,
                    fontWeight = FontWeight.Medium,
                ),
                maxLines = 1,
            )
            Spacer(modifier = GlanceModifier.height(6.dp))
            Header(snapshot = snapshot, titleSize = 24)
            Spacer(modifier = GlanceModifier.height(8.dp))
            Progress(snapshot = snapshot)
            Spacer(modifier = GlanceModifier.height(6.dp))
            StatusLabel(snapshot = snapshot, compact = false)
            Spacer(modifier = GlanceModifier.defaultWeight())
            Row(modifier = GlanceModifier.fillMaxWidth()) {
                AmountButton(context, "+250", 250, GlanceModifier.defaultWeight())
                Spacer(modifier = GlanceModifier.width(8.dp))
                AmountButton(context, "+350", 350, GlanceModifier.defaultWeight())
                Spacer(modifier = GlanceModifier.width(8.dp))
                AmountButton(context, "+500", 500, GlanceModifier.defaultWeight())
                Spacer(modifier = GlanceModifier.width(8.dp))
                AmountButton(context, "-250", -250, GlanceModifier.defaultWeight())
            }
        }
    }

    @Composable
    private fun Header(snapshot: HydrationSnapshot?, titleSize: Int) {
        val consumed = snapshot?.consumedText ?: "- ml"
        val goal = snapshot?.goalText ?: "- ml"
        Row(
            modifier = GlanceModifier.fillMaxWidth(),
            verticalAlignment = Alignment.CenterVertically,
        ) {
            Text(
                text = consumed,
                style = TextStyle(
                    color = GlanceTheme.colors.onSurface,
                    fontSize = titleSize.sp,
                    fontWeight = FontWeight.Bold,
                ),
                maxLines = 1,
            )
            Spacer(modifier = GlanceModifier.defaultWeight())
            Text(
                text = goal,
                style = TextStyle(
                    color = GlanceTheme.colors.onSurfaceVariant,
                    fontSize = 12.sp,
                ),
                maxLines = 1,
            )
        }
    }

    @Composable
    private fun Progress(snapshot: HydrationSnapshot?) {
        LinearProgressIndicator(
            progress = (snapshot?.progress ?: 0.0).coerceIn(0.0, 1.0).toFloat(),
            modifier = GlanceModifier.fillMaxWidth().height(8.dp),
            color = HydrationBlue,
            backgroundColor = GlanceTheme.colors.surfaceVariant,
        )
    }

    @Composable
    private fun StatusLabel(snapshot: HydrationSnapshot?, compact: Boolean) {
        val text = statusText(snapshot)
        if (compact && text == "Today") return

        Spacer(modifier = GlanceModifier.height(if (compact) 4.dp else 0.dp))
        Text(
            text = text,
            style = TextStyle(
                color = GlanceTheme.colors.onSurfaceVariant,
                fontSize = if (compact) 11.sp else 12.sp,
            ),
            maxLines = 1,
        )
    }

    @Composable
    private fun AmountButton(
        context: Context,
        label: String,
        amountMl: Int,
        modifier: GlanceModifier,
    ) {
        val intent = Intent(context, HydrationWidgetReceiver::class.java).apply {
            action = HydrationWidgetReceiver.ACTION_ADJUST_WATER
            putExtra(HydrationWidgetReceiver.EXTRA_AMOUNT_ML, amountMl)
        }
        Box(
            modifier = modifier
                .height(34.dp)
                .background(if (amountMl > 0) HydrationBlue else GlanceTheme.colors.surfaceVariant)
                .appWidgetBackgroundCornerRadius()
                .clickable(actionSendBroadcast(intent)),
            contentAlignment = Alignment.Center,
        ) {
            Text(
                text = label,
                style = TextStyle(
                    color = if (amountMl > 0) ColorProvider(Color.White) else GlanceTheme.colors.onSurface,
                    fontSize = 13.sp,
                    fontWeight = FontWeight.Bold,
                ),
                maxLines = 1,
            )
        }
    }

    private fun loadSnapshot(context: Context): HydrationSnapshot? {
        val prefs = context.getSharedPreferences(
            HydrationWidgetReceiver.PREFS_NAME,
            Context.MODE_PRIVATE,
        )
        return parseSnapshot(prefs.getString(HydrationWidgetReceiver.PREFS_KEY_SNAPSHOT, null))
    }

    private fun parseSnapshot(json: String?): HydrationSnapshot? {
        if (json == null) return null
        return try {
            val obj = JSONObject(json)
            val date = obj.optString("date", "")
            if (!isToday(date)) return null
            HydrationSnapshot(
                date = date,
                consumedMl = obj.optDouble("consumedMl", 0.0),
                goalMl = obj.optDouble("goalMl", 0.0),
                progress = obj.optDouble("progress", 0.0),
                consumedText = obj.optString("consumedText", "0 ml"),
                goalText = obj.optString("goalText", "0 ml"),
                lastUpdated = obj.optLong("lastUpdated", 0L),
                status = obj.optString("status", "ok"),
            )
        } catch (e: Exception) {
            null
        }
    }

    private fun isToday(date: String): Boolean {
        if (date.isBlank()) return false
        return try {
            val parsed = LocalDate.parse(date, DateTimeFormatter.ISO_LOCAL_DATE)
            parsed == LocalDate.now()
        } catch (e: Exception) {
            false
        }
    }

    private fun statusText(snapshot: HydrationSnapshot?): String {
        if (snapshot == null) return "Open app to sync"
        if (snapshot.status == "failed") return "Sync failed"
        if (snapshot.status == "needsSetup") return "Open app to finish setup"
        if (snapshot.lastUpdated <= 0L) return "Today"
        val time = Instant.ofEpochSecond(snapshot.lastUpdated)
            .atZone(ZoneId.systemDefault())
            .toLocalTime()
        return String.format(Locale.getDefault(), "Updated %02d:%02d", time.hour, time.minute)
    }

    private data class HydrationSnapshot(
        val date: String,
        val consumedMl: Double,
        val goalMl: Double,
        val progress: Double,
        val consumedText: String,
        val goalText: String,
        val lastUpdated: Long,
        val status: String,
    )

    companion object {
        val SNAPSHOT_STATE_KEY = stringPreferencesKey(HydrationWidgetReceiver.PREFS_KEY_SNAPSHOT)
        val HydrationBlue = ColorProvider(Color(0xFF0EA5E9))
    }
}
